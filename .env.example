# ---------- Allgemein ----------
APP_ENV=development
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:3000

# ---------- Datenbank (Standard: Supabase eu-central-1 | Sovereign: Hetzner Postgres) ----------
DATABASE_URL=postgres://chopstr:chopstr@localhost:5432/chopstr

# ---------- Redis (LLM-Cache, Sessions) ----------
REDIS_URL=redis://localhost:6379

# ---------- Temporal (self-hosted, EU) ----------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_CPU=chopstr-cpu
TEMPORAL_TASK_QUEUE_GPU=chopstr-gpu

# ---------- Objektspeicher (S3-kompatibel, EU-Region; lokal MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=chopstr
S3_SECRET_KEY=chopstr-secret
S3_BUCKET_SOURCES=chopstr-sources
S3_BUCKET_DERIVED=chopstr-derived
S3_FORCE_PATH_STYLE=true

# ---------- Medien-URLs für die Web-App (Poster, MP4, SRT aus dem derived-Bucket) ----------
# lokal MinIO path-style; Produktion: CDN oder signierte URLs (Phase 4)
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/chopstr-derived

# ---------- TUS-Upload (tusd) ----------
TUS_ENDPOINT=http://localhost:1080/files/
TUS_HOOK_SECRET=change-me-in-production
UPLOAD_MAX_BYTES=5368709120

# ---------- LLM (providers_llm: Residency-Guard) ----------
# standard -> bedrock-eu (Claude über AWS Bedrock, EU-Inference-Profil)
# sovereign -> mistral-eu oder selfhost-eu
LLM_PROVIDER=bedrock-eu
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=
SELFHOST_LLM_BASE_URL=

# ---------- ASR / Diarisierung ----------
ASR_MODEL_DE=primeline/whisper-large-v3-turbo-german
ASR_MODEL_CH=models/swissgerman-ct2
ASR_DEVICE=auto
ASR_COMPUTE=int8
HF_TOKEN=
# Fallback-ASR (europäisch, OVH/Gladia) nur nach Freischaltung pro Workspace
GLADIA_API_KEY=
GLADIA_BASE_URL=

# ---------- Reframing (Phase 3) ----------
# YuNet-ONNX (Apache-2.0) nach workers/models laden; fehlt die Datei, rendert der Worker mit neutralem Crop
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx

# ---------- Grammatik ----------
LANGUAGETOOL_URL=http://localhost:8010/v2

# ---------- Provenienz (C2PA) ----------
C2PA_SIGN_CERT=
C2PA_PRIVATE_KEY=

# ---------- Residency-Guard ----------
# Kommagetrennte Host-Allowlist für ausgehende Netzwerkaufrufe der Worker (leer = nur EU-Defaults)
EGRESS_ALLOWLIST=

# ---------- Observability (EU-gehostet, keine Transkriptinhalte) ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
