# ---------- Allgemein ----------
APP_ENV=development
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:3000

# ---------- Datenbank (Standard: Supabase eu-central-1 | Sovereign: Hetzner Postgres) ----------
DATABASE_URL=postgres://chopstr:chopstr@localhost:5432/chopstr
# Auth-Tabellen (users, sessions, login_tokens) über eine Rolle mit BYPASSRLS; leer = DATABASE_URL
DATABASE_AUTH_URL=

# ---------- Redis (LLM-Cache, Sessions) ----------
REDIS_URL=redis://localhost:6379

# ---------- Temporal (self-hosted, EU) ----------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_CPU=chopstr-cpu
TEMPORAL_TASK_QUEUE_GPU=chopstr-gpu

# ---------- Objektspeicher (S3-kompatibel, EU-Region; lokal MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=chopstr
S3_SECRET_KEY=chopstr-secret
S3_BUCKET_SOURCES=chopstr-sources
S3_BUCKET_DERIVED=chopstr-derived
S3_FORCE_PATH_STYLE=true

# ---------- Medien-URLs für die Web-App (Poster, MP4, SRT aus dem derived-Bucket) ----------
# lokal MinIO path-style; Produktion: CDN oder signierte URLs (Phase 4)
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/chopstr-derived

# ---------- TUS-Upload (tusd) ----------
TUS_ENDPOINT=http://localhost:1080/files/
TUS_HOOK_SECRET=change-me-in-production
UPLOAD_MAX_BYTES=5368709120

# ---------- Lokaler Testmodus ohne Docker (kein tusd, kein MinIO, kein Temporal) ----------
# UPLOAD_MODE=direct: die Web-App nimmt die Datei per POST /api/uploads/direct entgegen und schreibt sie nach
#   LOCAL_STORAGE_DIR/<S3_BUCKET_SOURCES>/uploads/<uuid><ext>; NEXT_PUBLIC_UPLOAD_MODE schaltet das Formular im Browser um.
# MEDIA_MODE=local: GET /api/media/<key> liefert Proxy, MP4, Poster, SRT und VTT aus LOCAL_STORAGE_DIR (dazu
#   NEXT_PUBLIC_MEDIA_BASE_URL=/api/media). Der Python-Worker nutzt denselben Ordner (python -m chopstr_worker.local_worker,
#   ohne S3_ENDPOINT und ohne TEMPORAL_ADDRESS).
UPLOAD_MODE=tus
NEXT_PUBLIC_UPLOAD_MODE=tus
MEDIA_MODE=s3
LOCAL_STORAGE_DIR=

# ---------- LLM (providers_llm: Residency-Guard) ----------
# standard -> bedrock-eu (Claude über AWS Bedrock, EU-Inference-Profil)
# sovereign -> mistral-eu oder selfhost-eu
LLM_PROVIDER=bedrock-eu
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=
SELFHOST_LLM_BASE_URL=
# Sovereign: OpenAI-kompatibler Endpunkt (vLLM), Modell-ID des gewählten offenen Modells (Lizenz prüfen)
SELFHOST_LLM_MODEL=
SELFHOST_LLM_API_KEY=

# ---------- ASR / Diarisierung ----------
ASR_MODEL_DE=primeline/whisper-large-v3-turbo-german
ASR_MODEL_CH=models/swissgerman-ct2
ASR_DEVICE=auto
ASR_COMPUTE=int8
# Ohne HF_TOKEN (oder ohne installiertes pyannote) gibt es keine Sprechertrennung: ALLE Woerter
# haengen dann an einer Person. Das ist zulaessig und wird in der Oberflaeche benannt - im
# Transkript und im Texteditor des Clips steht ein Satz dazu. Stillschweigend passiert es nicht.
HF_TOKEN=
# Fallback-ASR (europäisch, OVH/Gladia) nur nach Freischaltung pro Workspace
GLADIA_API_KEY=
GLADIA_BASE_URL=

# ---------- Effekte ----------
# Es gibt keine Variable dafuer. Effekte stehen je Clip in clips.effekte (Migration 0015);
# gesetzt werden sie beim Clippen automatisch und in der Oberflaeche von Hand. Der Renderer
# braucht dafuer den ffmpeg-Filter zoompan - fehlt er, wird ohne Effekte geclippt und das steht
# als Hinweis am Clip.

# ---------- Schriften ----------
# Ordner mit den Untertitel-Schriften. Leer = workers/fonts, und dort liegen alle neun Schriften
# der Auswahl im Repository. Nur setzen, wenn ein Image sie woanders ablegt; liegt dort eine Datei
# nicht, faellt der Render auf Inter zurueck und sagt es am Clip.
RENDER_FONTS_DIR=

# ---------- Ausgabepruefung (Migration 0014) ----------
# Der Regelkatalog dafuer, wann eine Clipfassung heruntergeladen oder veroeffentlicht werden darf,
# und die Grenzwerte der technischen Pruefung der fertigen Datei. Web-App und Worker lesen dieselbe
# Datei. Ohne diese Variable sucht der Worker sie unter <monorepo>/packages/schema/; gesetzt wird
# sie nur, wenn ein Image sie woanders ablegt.
CHOPSTR_AUSGABE_REGELN=
# Achtung beim Bauen des Worker-Image: ein ffmpeg ohne libass kann keine Untertitel einbrennen. Der
# Renderer merkt das und laesst sie weg; seit der technischen Pruefung schlaegt das fehl, statt
# still ein Video ohne Untertitel auszuliefern.

# ---------- Reframing (Phase 3) ----------
# YuNet-ONNX (Apache-2.0) nach workers/models laden; fehlt die Datei, rendert der Worker mit neutralem Crop
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx

# ---------- Grammatik ----------
LANGUAGETOOL_URL=http://localhost:8010/v2

# ---------- Provenienz (C2PA) ----------
C2PA_SIGN_CERT=
C2PA_PRIVATE_KEY=

# ---------- Residency-Guard ----------
# Kommagetrennte Host-Allowlist für ausgehende Netzwerkaufrufe der Worker (leer = nur EU-Defaults)
# --- Musik ---------------------------------------------------------------------------------
# Epidemic Sound Partner Content API. Der Schlüssel gehört NUR hierher, nie in den Code und nie
# in den Browser: er ist die Abrechnung des ganzen Kontos. Anlegen im Entwicklerportal unter
# „Authentication settings > API keys".
#
# Ohne Schlüssel bleibt die Bibliothek leer. Eigene Musik hochladen geht trotzdem - dafür braucht
# es niemanden von aussen.
EPIDEMIC_API_KEY=
EPIDEMIC_BASE_URL=https://partner-content-api.epidemicsound.com

EGRESS_ALLOWLIST=

# ---------- Observability (EU-gehostet, keine Transkriptinhalte) ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Phase 4: Auth, E-Mail, Abrechnung, AVV, Retention ----------
SESSION_SECRET=change-me-32-bytes-min
# EU-SMTP, z. B. smtp://user:pass@smtp.eu-provider.example:587 ; leer = Links werden in der Konsole geloggt
SMTP_URL=
MAIL_FROM=chopstr <noreply@placemedia.at>
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SOVEREIGN=
DPA_VERSION=2026-09
RETENTION_CRON=0 3 * * *
RETENTION_TIMEZONE=Europe/Vienna

# ---------- Phase 5: API, Webhooks, Publishing, Lernschleife, MCP ----------
# 32 Bytes base64 für AES-256-GCM (Verbindungs-Zugangsdaten): openssl rand -base64 32
CREDENTIALS_KEY=
API_RATE_LIMIT_PER_MIN=600
WEBHOOK_TIMEOUT_MS=8000
OUTBOX_INTERVAL_S=30
WEEKLY_REPORT_CRON=0 7 * * 1
# Plattform-Apps (leer = Provider „nicht konfiguriert“, manueller Connector bleibt verfügbar)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# MCP-Server (packages/mcp-server)
CHOPSTR_API_URL=http://localhost:3000/api/v1
CHOPSTR_API_KEY=
INTERNAL_API_SECRET=change-me-internal
APP_INTERNAL_URL=http://localhost:3000
