# apps/web/.env.local für den lokalen Testmodus ohne Docker (kopieren und Pfade anpassen)
DATABASE_URL=postgres://chopstr@127.0.0.1:5499/chopstr
UPLOAD_MODE=direct
NEXT_PUBLIC_UPLOAD_MODE=direct
MEDIA_MODE=local
NEXT_PUBLIC_MEDIA_BASE_URL=/api/media
# absoluter Pfad zum Repo-Ordner .local/storage
LOCAL_STORAGE_DIR=/ABSOLUTER/PFAD/zu/chopstr/.local/storage
TUS_HOOK_SECRET=local-dev-secret
INTERNAL_API_SECRET=local-dev-internal
SESSION_SECRET=local-dev-session-secret-mindestens-32-zeichen
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# Öffentliche Messwerte für Linktest und Link-Tracking. Leer lassen geht: dann meldet der Linktest
# „nicht konfiguriert“ statt Zahlen.
# YouTube Data API v3 (API-Schlüssel)
YOUTUBE_API_KEY=
# X API v2 (App-Bearer-Token, kostet je gelesenem Beitrag)
X_BEARER_TOKEN=
# Tagesdeckel für X-Abrufe, leer = 500
X_DAILY_READ_CAP=
# Drittanbieter für TikTok und Instagram, noch nicht angebunden. US-Anbieter, im Sovereign-Tarif nicht zulässig.
PUBLIC_METRICS_SCRAPER=
SCRAPECREATORS_API_KEY=
# Gilt für den Worker, nicht für die Web-App: workers/scripts/local_env.sh setzt METRICS_POLLING=1,
# damit der lokale Worker verfolgte Links misst. Hier nur zur Übersicht, leer lassen.
METRICS_POLLING=
# Mehrstufige Engine und Trainingsschleife (gilt für den Worker, docs/TRAINING-WORKFLOW.md).
# Anthropic und Google AI Studio sind keine EU-Anbieter: nur mit CHOPSTR_ALLOW_NON_EU_PROVIDERS=1.
CHOPSTR_ALLOW_NON_EU_PROVIDERS=
# Schlüssel der Anthropic-API, nur serverseitig
ANTHROPIC_API_KEY=
# Modell je Stufe, leer = Standard (Haiku für Vorfilter und Richter, Sonnet für Editor und Eskalation)
CHOPSTR_MODEL_PREFILTER=
CHOPSTR_MODEL_EDITOR=
CHOPSTR_MODEL_JUDGE=
CHOPSTR_MODEL_JUDGE_ESCALATE=
# Pfad zur Claude-CLI für LLM_PROVIDER=claude-cli (nur Entwicklung), leer = claude
CHOPSTR_CLAUDE_CLI=
# Zusätzliche Argumente für claude -p (vorher mit claude --help prüfen), leer = keine
CHOPSTR_CLAUDE_CLI_ARGS=
# Multimodaler Scan: gemini, mock oder none
CHOPSTR_MM_PROVIDER=
CHOPSTR_MODEL_MM=
# Google AI Studio oder Vertex AI (EU-Region)
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT=
VERTEX_LOCATION=
# Engine: leer = bisheriger Pfad, tiered = mehrstufig
CHOPSTR_ENGINE=
# Preistabelle (JSON, EUR je 1 Mio. Token), Batch-Anteil, Budget je Lauf
CHOPSTR_PRICE_TABLE=
CHOPSTR_BATCH_DISCOUNT=
CHOPSTR_RUN_BUDGET_EUR=
CHOPSTR_RUN_BUDGET_TOKENS=
