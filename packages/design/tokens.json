{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "chopstr Lichtbruch",
  "color": {
    "bg": { "value": "#000000", "role": "Raum" },
    "bg-raised": { "value": "#0a0a13", "role": "Erhobene Flächen, Logo-Tinte" },
    "text": { "value": "#f4f5fe", "role": "Primärtext, Aktion" },
    "text-2": { "value": "#a1a1aa" },
    "text-3": { "value": "#71717a" },
    "text-4": { "value": "#52525b" },
    "line-mute": { "value": "#27272a" },
    "brand": { "value": "#020cf5", "role": "Marke, Klinge, Lichtkanten. Nie als Fließtext." },
    "brand-deep": { "value": "#1b1a62", "role": "Sekundärfläche, KI-Vorschlag-Hintergrund" },
    "ai": { "value": "#2f6bff", "role": "KI arbeitet / KI-Vorschlag ausgewählt" },
    "ai-soft": { "value": "#5b8cff", "role": "Glühen" },
    "attention": { "value": "#ff7a45", "role": "Mensch muss prüfen. Sonst nie." },
    "spectrum-1": { "value": "#ffb27a", "role": "Verwandlung" },
    "spectrum-2": { "value": "#7fd4ff", "role": "Verwandlung" },
    "spectrum-3": { "value": "#ff4fa3", "role": "Verwandlung" },
    "danger": { "value": "#ff5c5c" }
  },
  "radius": { "card": "30px", "inner": "18px", "pill": "999px" },
  "blur": { "glass": "32px" },
  "opacity": { "grain": 0.05, "glass": 0.05, "line": 0.12, "line-strong": 0.18 },
  "motion": { "ease": "cubic-bezier(0.22, 0.8, 0.2, 1)", "duration": "550ms", "duration-fast": "220ms" },
  "font": {
    "sans": "Geist, Inter, system-ui, sans-serif",
    "mono": "Geist Mono, ui-monospace, monospace",
    "tracking-display": "-0.03em"
  },
  "rules": [
    "Weiß = Aktion. Primär-Button ist eine weiße Pill, Sekundär eine Ghost-Pill mit 1-px-Rand.",
    "Farbe nur als Licht (Kanten, Glühen, Dispersion), keine flächigen Farbfüllungen.",
    "Orange ausschließlich für Warnungen, die ein Mensch prüfen muss.",
    "Spektrum-Glitch nur, wenn Clips entstehen oder ein Render fertig ist.",
    "Keine Emojis in der UI, kein lila SaaS-Verlauf, kein Hype-Wording, keine Gedankenstriche in UI-Texten.",
    "Fließtext nie dunker als text-2, immer auf ausreichend dunklem Glas (WCAG AA).",
    "Fallback ohne backdrop-filter: solide bg-raised-Fläche.",
    "Preise im DACH-Format: 29 €, 9,99 €.",
    "Mikro-Labels in Kleinbuchstaben mit Punkt (clip., freigabe.) sparsam als Signatur."
  ]
}
