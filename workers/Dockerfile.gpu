# chopstr Worker, GPU-Variante (ASR und Diarisierung). Build-Kontext: Monorepo-Root
#   docker build -f workers/Dockerfile.gpu -t chopstr-worker-gpu .
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ffmpeg fonts-inter ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Gemeinsame Dateien aus dem Monorepo, wie im CPU-Image (siehe workers/Dockerfile)
COPY packages/prompts /app/packages/prompts
COPY packages/editorial /app/packages/editorial
COPY packages/design /app/packages/design
COPY packages/schema /app/packages/schema
COPY workers/pyproject.toml workers/README.md /app/workers/
COPY workers/chopstr_worker /app/workers/chopstr_worker
COPY workers/eval /app/workers/eval
COPY workers/fonts /app/workers/fonts

# torch mit CUDA-Wheels; Version an das Basis-Image anpassen. spaCy-Sprachmodell für die Verbklammer (P28):
# Release-Wheel aus explosion/spacy-models im selben pip-Aufruf wie das Extra nlp, nie zur Laufzeit geladen.
ARG SPACY_MODEL_VERSION=3.8.0
RUN python3 -m pip install --no-cache-dir --upgrade pip \
 && python3 -m pip install --no-cache-dir "/app/workers[asr,nlp]" "de_core_news_md @ https://github.com/explosion/spacy-models/releases/download/de_core_news_md-${SPACY_MODEL_VERSION}/de_core_news_md-${SPACY_MODEL_VERSION}-py3-none-any.whl"

# Modelle werden zur Laufzeit geladen (ASR_MODEL_DE, ASR_MODEL_CH, HF_TOKEN); Cache als Volume mounten:
#   -v /srv/hf-cache:/home/worker/.cache
WORKDIR /app/workers
RUN useradd -m worker && chown -R worker /app
USER worker
ENV ASR_DEVICE=cuda ASR_COMPUTE=int8_float16

ENTRYPOINT ["python3", "-m", "chopstr_worker.worker"]
CMD ["--queues", "gpu"]
